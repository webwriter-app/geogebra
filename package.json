  "exports": {
    "./widgets/webwriter-geogebra.*": {
      "source": "./src/widgets/webwriter-geogebra.ts",
      "default": "./dist/widgets/webwriter-geogebra.*"
    },
    "./widgets/webwriter-geogebra-geometry.*": {
      "source": "./src/widgets/webwriter-geogebra-geometry.ts",
      "default": "./dist/widgets/webwriter-geogebra-geometry.*"
    },
    "./widgets/webwriter-geogebra-3d.*": {
      "source": "./src/widgets/webwriter-geogebra-3d.ts",
      "default": "./dist/widgets/webwriter-geogebra-3d.*"
    },
    "./widgets/webwriter-geogebra-notes.*": {
      "source": "./src/widgets/webwriter-geogebra-notes.ts",
      "default": "./dist/widgets/webwriter-geogebra-notes.*"
    },
    "./widgets/webwriter-geogebra-scientific.*": {
      "source": "./src/widgets/webwriter-geogebra-scientific.ts",
      "default": "./dist/widgets/webwriter-geogebra-scientific.*"
    },
    "./widgets/webwriter-geogebra-classic.*": {
      "source": "./src/widgets/webwriter-geogebra-classic.ts",
      "default": "./dist/widgets/webwriter-geogebra-classic.*"
    },
    "./tests/data-block.*": {
      "source": "./tests/data-block.test.ts",
      "default": "./dist/tests/data-block.*"
    },
    "./tests/language.*": {
      "source": "./tests/language.test.ts",
      "default": "./dist/tests/language.*"
    },
    "./tests/presentation.*": {
      "source": "./tests/presentation.test.ts",
      "default": "./dist/tests/presentation.*"
    },
    "./tests/conversions.*": {
      "source": "./tests/conversions.test.ts",
      "default": "./dist/tests/conversions.*"
    },
    "./icon": "./icon.svg",
    "./preview": "./assets/preview.mp4",
    "./preview/de": "./assets/preview-de.mp4",
    "./editing-config.json": "./editing-config.json",
    "./custom-elements.json": "./custom-elements.json"
  },
  "editingConfig": {
    ".": {},
    "./widgets/webwriter-geogebra": {
      "content": "text*",
      "importFormats": [
        ".ggb"
      ],
      "exportFormats": [
        ".ggb",
        "image/png",
        "image/svg+xml"
      ]
    },
    "./widgets/webwriter-geogebra-geometry": {
